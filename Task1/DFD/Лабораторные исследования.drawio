        </mxCell>
        <mxCell id="stores-mapping" value="МАППИНГ ХРАНИЛИЩ:&#xa;D1 (Медкарты) ← [PD]+[PHI] История пациента&#xa;D2 (Реестр) ← [PD]+[SAMPLE] Регистрация анализов&#xa;D3 (Направления) ← [PD]+[PHI] Назначения врача&#xa;D4 (Журнал забора) ← [PD]+[SAMPLE] Учёт образцов&#xa;D5 (Результаты) ← [PHI] Данные исследований&#xa;D6 (Архив) ← [PD]+[PHI] Архивные результаты" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontFamily=Verdana;whiteSpace=wrap;fontStyle=1;" parent="1" vertex="1">
