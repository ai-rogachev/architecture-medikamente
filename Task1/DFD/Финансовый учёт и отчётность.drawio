        <mxCell id="ctx-leg2-t" value="Система (Context Diagram)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Verdana;" parent="1" vertex="1">
          <mxGeometry x="150" y="725" width="180" height="25" as="geometry" />
