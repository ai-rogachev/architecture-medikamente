          <mxGeometry x="1210" y="249.09" width="330" height="30" as="geometry" />
        </mxCell>
        <mxCell id="leg-flow-solid" value="" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#333333;endFill=1;endSize=8;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1100" y="299.09" as="sourcePoint" />
            <mxPoint x="1200" y="299.09" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-flow-solid-label" value="Поток данных (запись)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Verdana;" parent="1" vertex="1">
          <mxGeometry x="1210" y="289.09" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="leg-flow-dashed" value="" style="endArrow=block;html=1;strokeWidth=1;strokeColor=#333333;endFill=1;endSize=8;dashed=1;" parent="1" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="1380" y="299.09" as="sourcePoint" />
            <mxPoint x="1480" y="299.09" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="leg-flow-dashed-label" value="Чтение данных" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Verdana;" parent="1" vertex="1">
          <mxGeometry x="1490" y="289.09" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="data-box" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#999999;fillColor=#FFF9E6;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="1080" y="350" width="480" height="240" as="geometry" />
        </mxCell>
        <mxCell id="data-label" value="КЛАССИФИКАЦИЯ ДАННЫХ (Data Classification)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Verdana;" parent="1" vertex="1">
          <mxGeometry x="1100" y="360" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="data-fin" value="[FIN] Финансовые данные:&#xa;• Суммы платежей, выручка&#xa;• Чеки ККМ, проводки 1С&#xa;• Налоговые расчёты" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Verdana;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1100" y="390" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="data-pd" value="[PD] Персональные данные:&#xa;• ПДн сотрудников (кадры)&#xa;• Связка платёж–пациент (в Excel)&#xa;• Зарплата, начисления" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Verdana;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1330" y="390" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="stores-mapping" value="МАППИНГ ХРАНИЛИЩ:&#xa;D1 (ККМ) ← [FIN] Фискальные данные операций&#xa;D2 (Excel) ← [FIN]+[PD] Дубликаты платежей (риск: связка пациент–платёж)&#xa;D3 (1С) ← [FIN]+[PD] Учёт, выручка, зарплата, налоги&#xa;D4 (Кадры) ← [PD] Сотрудники, начисления&#xa;D5 (Архив) ← [FIN] Отчётность в госорганы, внутренняя" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=9;fontFamily=Verdana;whiteSpace=wrap;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1100" y="469.99999999999994" width="440" height="100" as="geometry" />
        </mxCell>
        <mxCell id="sec-box" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#CC0000;fillColor=#FFE6E6;strokeWidth=1;" parent="1" vertex="1">
          <mxGeometry x="1080" y="624.09" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="sec-label" value="ПРОБЛЕМНЫЕ ЗОНЫ БЕЗОПАСНОСТИ" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontFamily=Verdana;fontColor=#CC0000;" parent="1" vertex="1">
          <mxGeometry x="1100" y="634.09" width="350" height="20" as="geometry" />
        </mxCell>
        <mxCell id="sec-text" value="• D2 (Excel) — связка платёж–пациент не защищена; дублирование создаёт избыточность (Data Minimization)&#xa;• 1С в файловом режиме — ограниченный аудит и разграничение доступа к ПДн и зарплате&#xa;• Потоки в Excel не прослеживаются (Data Lineage); неполная прослеживаемость в 1С&#xa;• Нет разграничения к ПДн сотрудников и финансовым данным (Privacy By Design)&#xa;• Рекомендация: отказ от дублирования в Excel или шифрование; серверный режим 1С для аудита" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=10;fontFamily=Verdana;whiteSpace=wrap;" parent="1" vertex="1">
          <mxGeometry x="1100" y="664.09" width="440" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="DFD Context (Level 0)" id="dfd-fin-context">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
