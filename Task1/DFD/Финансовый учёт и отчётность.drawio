        <mxCell id="ctx-1c" value="1С:Бухгалтерия&#xa;(Accounting DB)" style="shape=rectangle;whiteSpace=wrap;html=1;rounded=0;shadow=1;strokeWidth=2;strokeColor=#333333;fillColor=#E6E6E6;fontFamily=Verdana;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
