        <mxCell id="ctx-leg2" value="0" style="ellipse;whiteSpace=wrap;html=1;strokeWidth=2;strokeColor=#0050A0;fillColor=#DBEAF9;fontFamily=Verdana;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="100" y="715" width="40" height="40" as="geometry" />
