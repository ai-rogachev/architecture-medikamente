          <mxGeometry x="100" y="680" width="40" height="25" as="geometry" />
        </mxCell>
        <mxCell id="ctx-leg1-t" value="Внешняя сущность" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=10;fontFamily=Verdana;" parent="1" vertex="1">
          <mxGeometry x="150" y="680" width="180" height="25" as="geometry" />
