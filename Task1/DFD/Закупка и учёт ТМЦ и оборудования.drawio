        <mxCell id="info-title" value="СВЯЗЬ С «ФИНАНСОВЫЙ УЧЁТ И ОТЧЁТНОСТЬ»" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;fontFamily=Verdana;" parent="1" vertex="1">
