        <mxCell id="rbac-content" value="&lt;div style=&quot;text-align: left; font-size: 11px;&quot;&gt;&lt;table border=&quot;1&quot; cellpadding=&quot;4&quot; style=&quot;border-collapse: collapse;&quot;&gt;&lt;tr style=&quot;background: #ddd;&quot;&gt;&lt;th&gt;Role&lt;/th&gt;&lt;th&gt;Profile&lt;/th&gt;&lt;th&gt;Medical&lt;/th&gt;&lt;th&gt;Schedule&lt;/th&gt;&lt;th&gt;Analytics&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Patient&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Own R/W&lt;/td&gt;&lt;td&gt;Own R&lt;/td&gt;&lt;td&gt;Own R/W&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Receptionist&lt;/b&gt;&lt;/td&gt;&lt;td&gt;All R (limited)&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;All R/W&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Doctor&lt;/b&gt;&lt;/td&gt;&lt;td&gt;Assigned R&lt;/td&gt;&lt;td&gt;Assigned R/W&lt;/td&gt;&lt;td&gt;Own R/W&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;b&gt;Analyst&lt;/b&gt;&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;-&lt;/td&gt;&lt;td&gt;Anon R&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;br&gt;&lt;b&gt;Legend:&lt;/b&gt;&lt;br&gt;R = Read, W = Write&lt;br&gt;Own = Only own data&lt;br&gt;Assigned = Assigned patients&lt;br&gt;Anon = Anonymized only&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="1530" y="160" width="330" height="270" as="geometry" />
