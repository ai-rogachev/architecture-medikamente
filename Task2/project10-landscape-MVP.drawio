        <object placeholders="1" c4Name="Data Categories" c4Type="Legend" c4Application="" label="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Data Categories&lt;/b&gt;&lt;/font&gt;" id="data-legend">
